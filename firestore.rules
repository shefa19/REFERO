rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // CORE HELPER FUNCTIONS & ROLE VERIFICATION
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
      return isAuthenticated() &&
        userDocExists(request.auth.uid) &&
        getUserData(request.auth.uid).role == 'admin';
    }

    function isShopkeeper() {
      return isAuthenticated() &&
        userDocExists(request.auth.uid) &&
        getUserData(request.auth.uid).role == 'shopkeeper';
    }

    function isShopOwner(shopId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/shops/$(shopId)) &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function isApprovedShop(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId)) &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.status == 'approved';
    }

    // =========================================================================
    // POINT TRANSFER & DELIVERY VERIFICATION HELPERS
    // =========================================================================

    // Validates that a user document debit is strictly authorized by an
    // active atomic transaction accepting a pending point transfer or point request.
    function isVerifiedTransferDebit(userId) {
      let reqId = request.resource.data.lastTransferRequestId;
      let reqRef = /databases/$(database)/documents/pointTransferRequests/$(reqId);
      return reqId is string &&
        existsAfter(reqRef) &&
        get(reqRef).data.status == 'pending' &&
        getAfter(reqRef).data.status == 'accepted' &&
        (
          // Case 1: Transfer - Sender userId debited, acceptor is recipient
          (get(reqRef).data.senderId == userId &&
           (getAfter(reqRef).data.recipientId == request.auth.uid || get(reqRef).data.recipientEmail == request.auth.token.email)) ||
          // Case 2: Point Request - Acceptor (userId == request.auth.uid) debited, sender is requester
          (userId == request.auth.uid &&
           (get(reqRef).data.recipientId == request.auth.uid || get(reqRef).data.recipientEmail == request.auth.token.email))
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pointsBalance', 'points', 'updatedAt', 'lastTransferRequestId']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.pointsBalance >= 0;
    }

    // Validates that a user document credit is strictly authorized by an
    // active atomic transaction accepting a pending point transfer or point request.
    function isVerifiedTransferCredit(userId) {
      let reqId = request.resource.data.lastTransferRequestId;
      let reqRef = /databases/$(database)/documents/pointTransferRequests/$(reqId);
      return reqId is string &&
        existsAfter(reqRef) &&
        get(reqRef).data.status == 'pending' &&
        getAfter(reqRef).data.status == 'accepted' &&
        (
          // Case 1: Transfer - Recipient userId credited
          (isOwner(userId) && (getAfter(reqRef).data.recipientId == userId || get(reqRef).data.recipientEmail == request.auth.token.email)) ||
          // Case 2: Point Request - Original requester userId (senderId) credited
          (get(reqRef).data.senderId == userId)
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pointsBalance', 'points', 'updatedAt', 'lastTransferRequestId']) &&
        request.resource.data.role == resource.data.role;
    }

    // Validates customer checkout discount point deduction
    function isVerifiedCheckoutRedemption(userId) {
      let orderId = request.resource.data.lastOrderRedemptionId;
      let orderRef = /databases/$(database)/documents/orders/$(orderId);
      return isOwner(userId) &&
        orderId is string &&
        existsAfter(orderRef) &&
        getAfter(orderRef).data.customerId == userId &&
        getAfter(orderRef).data.pointsUsed > 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pointsBalance', 'points', 'updatedAt', 'lastOrderRedemptionId']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.pointsBalance == resource.data.pointsBalance - getAfter(orderRef).data.pointsUsed &&
        request.resource.data.pointsBalance >= 0;
    }

    // Validates that loyalty points credited upon order delivery are authorized
    // either by the authenticated customer confirming receipt or by an Admin.
    function isVerifiedDeliveryPointCredit(userId) {
      let orderId = request.resource.data.lastDeliveryOrderId;
      let orderRef = /databases/$(database)/documents/orders/$(orderId);
      return orderId is string &&
        existsAfter(orderRef) &&
        get(orderRef).data.customerId == userId &&
        get(orderRef).data.pointsCredited == false &&
        getAfter(orderRef).data.orderStatus in ['completed', 'delivered'] &&
        getAfter(orderRef).data.pointsCredited == true &&
        (isAdmin() || isOwner(userId)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pointsBalance', 'points', 'pendingPoints', 'updatedAt', 'lastDeliveryOrderId']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.pointsBalance == resource.data.pointsBalance + get(orderRef).data.pointsEarned;
    }

    // Validates point reversal or restoration upon order refund
    function isVerifiedRefundPointReversal(userId) {
      let orderId = request.resource.data.lastRefundOrderId;
      let orderRef = /databases/$(database)/documents/orders/$(orderId);
      return orderId is string &&
        existsAfter(orderRef) &&
        get(orderRef).data.customerId == userId &&
        getAfter(orderRef).data.orderStatus == 'refunded' &&
        (isAdmin() || (isShopkeeper() && isShopOwner(get(orderRef).data.shopId))) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pointsBalance', 'points', 'updatedAt', 'lastRefundOrderId']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.pointsBalance >= 0;
    }

    // =========================================================================
    // USERS COLLECTION (/users/{userId}) — USER PRIVACY & GET COMPATIBILITY
    // =========================================================================
    match /users/{userId} {
      // Privacy & Transaction Compatibility:
      // Single-doc get allowed for authenticated users (enabling atomic point transfers, recipient checks, and storefront vendor details)
      // Directory-wide queries (list) strictly restricted to Admin to prevent user scraping
      allow get: if isAuthenticated();
      allow list: if isAdmin();

      // Public registration strictly creates role 'customer' with 0 initial points
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'customer' &&
        (!('status' in request.resource.data) || request.resource.data.status == 'active') &&
        (!('points' in request.resource.data) || request.resource.data.points == 0) &&
        (!('pointsBalance' in request.resource.data) || request.resource.data.pointsBalance == 0) &&
        (!('pendingPoints' in request.resource.data) || request.resource.data.pendingPoints == 0);

      allow update: if isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.role == resource.data.role &&
          (!('status' in resource.data) || request.resource.data.status == resource.data.status) &&
          (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid) &&
          (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
          (!('referralCode' in resource.data) || request.resource.data.referralCode == resource.data.referralCode) &&
          (!('referredBy' in resource.data) || request.resource.data.referredBy == resource.data.referredBy) &&
          request.resource.data.pointsBalance == resource.data.pointsBalance &&
          request.resource.data.points == resource.data.points
        ) ||
        isVerifiedTransferDebit(userId) ||
        isVerifiedTransferCredit(userId) ||
        isVerifiedCheckoutRedemption(userId) ||
        isVerifiedDeliveryPointCredit(userId) ||
        isVerifiedRefundPointReversal(userId);

      allow delete: if isAdmin();

      match /cart/{cartItemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // SHOPS COLLECTION (/shops/{shopId}) — PUBLIC SELLER INFORMATION
    // =========================================================================
    match /shops/{shopId} {
      // Approved shops provide legitimate public store profiles
      allow read: if (resource.data.status == 'approved') ||
        (isAuthenticated() && resource.data.ownerId == request.auth.uid) ||
        isAdmin();

      // Sellers submit application with initial status 'pending'
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0
      );

      // Sellers can only update shop profile & policies; cannot alter status or ratings
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        resource.data.status == 'approved' &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.status == resource.data.status &&
        (!('rating' in resource.data) || request.resource.data.rating == resource.data.rating) &&
        (!('reviewCount' in resource.data) || request.resource.data.reviewCount == resource.data.reviewCount)
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // PRODUCTS COLLECTION (/products/{productId}) — PRODUCT SECURITY
    // =========================================================================
    match /products/{productId} {
      allow read: if true;

      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.shopId is string &&
        isShopOwner(request.resource.data.shopId) &&
        isApprovedShop(request.resource.data.shopId) &&
        request.resource.data.price is number && request.resource.data.price >= 0 &&
        request.resource.data.stock is number && request.resource.data.stock >= 0
      );

      // Product Security: Sellers cannot change shopId, rating, reviewCount, or createdAt.
      // Updates are restricted strictly to legitimate product catalog fields.
      allow update: if isAdmin() || (
        isShopOwner(resource.data.shopId) &&
        isApprovedShop(resource.data.shopId) &&
        request.resource.data.shopId == resource.data.shopId &&
        (!('rating' in resource.data) || request.resource.data.rating == resource.data.rating) &&
        (!('reviewCount' in resource.data) || request.resource.data.reviewCount == resource.data.reviewCount) &&
        request.resource.data.price is number && request.resource.data.price >= 0 &&
        request.resource.data.stock is number && request.resource.data.stock >= 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'price', 'originalPrice', 'stock', 'unit',
          'category', 'brand', 'images', 'image', 'badge', 'discount',
          'pointsEarned', 'pointPrice', 'canRedeemWithPoints', 'tags',
          'updatedAt', 'inStock'
        ])
      );

      allow delete: if isAdmin() || (
        isShopOwner(resource.data.shopId) &&
        isApprovedShop(resource.data.shopId)
      );
    }

    // =========================================================================
    // ORDERS COLLECTION (/orders/{orderId}) — ORDER & DELIVERY VERIFICATION
    // =========================================================================
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid) ||
        (isAuthenticated() && ('shopId' in resource.data) && isShopOwner(resource.data.shopId)) ||
        (isAuthenticated() && ('shopIds' in resource.data) && resource.data.shopIds.hasAny([getUserData(request.auth.uid).shopId]));

      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.orderStatus == 'placed' &&
        request.resource.data.pointsCredited == false &&
        request.resource.data.referralRewardCredited == false &&
        request.resource.data.totalAmount is number && request.resource.data.totalAmount >= 0 &&
        request.resource.data.subtotal is number && request.resource.data.subtotal >= 0
      );

      allow update: if isAdmin() || (
        // 1. Customer cancellation while order is still placed
        isAuthenticated() &&
        resource.data.customerId == request.auth.uid &&
        resource.data.orderStatus == 'placed' &&
        request.resource.data.orderStatus == 'cancelled' &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.pointsCredited == false
      ) || (
        // 2. Customer confirming receipt: points credited exactly once, restricted fields
        isAuthenticated() &&
        resource.data.customerId == request.auth.uid &&
        resource.data.orderStatus in ['delivered', 'shipped', 'out_for_delivery'] &&
        resource.data.pointsCredited == false &&
        request.resource.data.orderStatus in ['completed', 'delivered'] &&
        request.resource.data.pointsCredited == true &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.totalAmount == resource.data.totalAmount &&
        request.resource.data.pointsUsed == resource.data.pointsUsed &&
        request.resource.data.pointsEarned == resource.data.pointsEarned &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'orderStatus', 'pointsCredited', 'completedAt', 'confirmedBy',
          'updatedAt', 'deliveredAt', 'referralRewardCredited'
        ])
      ) || (
        // 3. Shopkeeper managing fulfillment status for their own orders
        // Sellers cannot self-award customer points (pointsCredited must remain unchanged)
        isShopkeeper() &&
        (
          (('shopId' in resource.data) && isShopOwner(resource.data.shopId)) ||
          (('shopIds' in resource.data) && resource.data.shopIds.hasAny([getUserData(request.auth.uid).shopId]))
        ) &&
        request.resource.data.orderStatus in ['confirmed', 'processing', 'shipped', 'out_for_delivery', 'delivered', 'cancelled'] &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.totalAmount == resource.data.totalAmount &&
        request.resource.data.pointsUsed == resource.data.pointsUsed &&
        request.resource.data.pointsEarned == resource.data.pointsEarned &&
        request.resource.data.pointsCredited == resource.data.pointsCredited
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // POINT TRANSACTIONS LEDGER (/pointTransactions/{txId}) - IMMUTABLE AUDIT TRAIL
    // =========================================================================
    match /pointTransactions/{txId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();

      // Only authorized ledger creation matching valid verified operations
      allow create: if isAdmin() || (
        isAuthenticated() && (
          // 1. Point Transfer / Request - Debit Ledger
          (
            request.resource.data.type == 'transfer_sent' &&
            request.resource.data.points < 0 &&
            request.resource.data.relatedId is string &&
            existsAfter(/databases/$(database)/documents/pointTransferRequests/$(request.resource.data.relatedId)) &&
            getAfter(/databases/$(database)/documents/pointTransferRequests/$(request.resource.data.relatedId)).data.status == 'accepted' &&
            (
              // Case 1: Transfer - sender is debited
              (getAfter(/databases/$(database)/documents/pointTransferRequests/$(request.resource.data.relatedId)).data.senderId == request.resource.data.userId) ||
              // Case 2: Request - acceptor (currentUser) is debited
              (request.resource.data.userId == request.auth.uid)
            ) &&
            request.resource.data.points == -get(/databases/$(database)/documents/pointTransferRequests/$(request.resource.data.relatedId)).data.points
          ) ||
          // 2. Point Transfer / Request - Credit Ledger
          (
            request.resource.data.type == 'transfer_received' &&
            request.resource.data.points > 0 &&
            request.resource.data.relatedId is string &&
            existsAfter(/databases/$(database)/documents/pointTransferRequests/$(request.resource.data.relatedId)) &&
            getAfter(/databases/$(database)/documents/pointTransferRequests/$(request.resource.data.relatedId)).data.status == 'accepted' &&
            (
              // Case 1: Transfer - acceptor (currentUser) is credited
              (request.resource.data.userId == request.auth.uid) ||
              // Case 2: Request - requester (senderId) is credited
              (request.resource.data.userId == getAfter(/databases/$(database)/documents/pointTransferRequests/$(request.resource.data.relatedId)).data.senderId)
            ) &&
            request.resource.data.points == get(/databases/$(database)/documents/pointTransferRequests/$(request.resource.data.relatedId)).data.points
          ) ||
          // 3. Checkout Discount - Customer spending points on an order
          (
            request.resource.data.type == 'checkout_discount' &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.points < 0 &&
            request.resource.data.relatedId is string &&
            existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)) &&
            getAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)).data.customerId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)).data.pointsUsed == -request.resource.data.points
          ) ||
          // 4. Order Earned - When order is delivered or completed; points exactly match pointsEarned
          (
            request.resource.data.type == 'order_earned' &&
            request.resource.data.points > 0 &&
            request.resource.data.relatedId is string &&
            existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)) &&
            getAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)).data.orderStatus in ['completed', 'delivered'] &&
            getAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)).data.pointsCredited == true &&
            getAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)).data.customerId == request.resource.data.userId &&
            request.resource.data.points == getAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)).data.pointsEarned &&
            (isAdmin() || isOwner(request.resource.data.userId))
          ) ||
          // 5. Refund Reversal - When order is refunded
          (
            request.resource.data.type == 'refund_reversal' &&
            request.resource.data.points < 0 &&
            request.resource.data.relatedId is string &&
            existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)) &&
            getAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)).data.orderStatus == 'refunded' &&
            (isAdmin() || (isShopkeeper() && isShopOwner(getAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)).data.shopId)))
          ) ||
          // 6. Admin Adjustment or cancellation refund point restore
          (
            request.resource.data.type in ['admin_adjustment', 'admin_adjustment_credit', 'admin_adjustment_debit'] &&
            (isAdmin() || (isShopkeeper() && request.resource.data.relatedId is string && existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId))))
          ) ||
          // 7. Referral Bonus - strictly bound to customer's completed qualifying order
          (
            request.resource.data.type == 'referral_bonus' &&
            request.resource.data.points > 0 &&
            request.resource.data.relatedId is string &&
            existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)) &&
            getAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)).data.orderStatus in ['completed', 'delivered'] &&
            (isAdmin() || getAfter(/databases/$(database)/documents/orders/$(request.resource.data.relatedId)).data.customerId == request.auth.uid)
          )
        )
      );

      // Ledger records are strictly immutable
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // POINT TRANSFER REQUESTS (/pointTransferRequests/{requestId})
    // =========================================================================
    match /pointTransferRequests/{requestId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid ||
          (('recipientEmail' in resource.data) && (
            resource.data.recipientEmail == request.auth.token.email ||
            resource.data.recipientEmail == request.auth.token.email.lower()
          ))
        )
      );

      // Transfer checks available balance; Request allows asking friends for points
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.points is number &&
        request.resource.data.points > 0 &&
        request.resource.data.senderId != request.resource.data.recipientId &&
        (!('recipientEmail' in request.resource.data) || request.resource.data.recipientEmail != request.auth.token.email) &&
        (
          request.resource.data.requestType == 'request' ||
          (userDocExists(request.auth.uid) && request.resource.data.points <= getUserData(request.auth.uid).pointsBalance)
        );

      // Transfer updates preserve all original transaction details.
      // Only recipient can accept/reject; only sender can cancel.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.status == 'pending' &&
        (
          // 1. Recipient accepting or rejecting
          (
            (
              resource.data.recipientId == request.auth.uid ||
              (('recipientEmail' in resource.data) && (
                resource.data.recipientEmail == request.auth.token.email ||
                resource.data.recipientEmail == request.auth.token.email.lower()
              ))
            ) &&
            request.resource.data.status in ['accepted', 'rejected'] &&
            request.resource.data.recipientId in [resource.data.recipientId, request.auth.uid]
          ) ||
          // 2. Sender cancelling pending request
          (
            resource.data.senderId == request.auth.uid &&
            request.resource.data.status == 'cancelled' &&
            request.resource.data.recipientId == resource.data.recipientId
          )
        ) &&
        // Strict preservation of all transaction details
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.senderEmail == resource.data.senderEmail &&
        request.resource.data.recipientEmail == resource.data.recipientEmail &&
        request.resource.data.points == resource.data.points &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (!('note' in resource.data) || request.resource.data.note == resource.data.note) &&
        (!('requestType' in resource.data) || request.resource.data.requestType == resource.data.requestType) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'recipientId', 'processedAt', 'updatedAt'])
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // REVIEWS COLLECTION (/reviews/{reviewId}) — SAFE INITIAL STATUS & VERIFICATION
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if (resource.data.status == 'published') ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid) ||
        (isAuthenticated() && ('shopId' in resource.data) && isShopOwner(resource.data.shopId)) ||
        isAdmin();

      // Enforces deterministic reviewId: review_{orderId}_{productId} preventing duplicate reviews.
      // Customers cannot self-publish: safe initial status is strictly 'pending'.
      // Validates order exists, is completed/delivered, belongs to this customer, and contains this product.
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        reviewId == 'review_' + request.resource.data.orderId + '_' + request.resource.data.productId &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0 &&
        request.resource.data.comment.size() <= 2000 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.orderId is string &&
        exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.orderStatus in ['completed', 'delivered'] &&
        (
          !('productIds' in get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data) ||
          get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.productIds.hasAny([request.resource.data.productId])
        )
      );

      // Customers cannot change review status (moderation reserved for Admin)
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.customerId == request.auth.uid &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.orderId == resource.data.orderId &&
        request.resource.data.productId == resource.data.productId &&
        request.resource.data.shopId == resource.data.shopId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'images', 'updatedAt'])
      );

      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.customerId == request.auth.uid
      );
    }

    // =========================================================================
    // REFERRALS COLLECTION (/referrals/{referralId}) — REFERRAL SECURITY
    // =========================================================================
    match /referrals/{referralId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.referrerUserId == request.auth.uid ||
          resource.data.referredUserId == request.auth.uid
        )
      );

      // Registration creates initial referral record in status 'registered'
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.referredUserId == request.auth.uid &&
        request.resource.data.referrerUserId != request.auth.uid &&
        request.resource.data.status == 'registered' &&
        request.resource.data.rewardPoints is number &&
        request.resource.data.rewardPoints > 0
      );

      // Update to 'reward_issued' verifies the qualifying completed order and prevents duplicate rewards
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.status == 'registered' &&
        request.resource.data.status == 'reward_issued' &&
        request.resource.data.qualifyingOrderId is string &&
        existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.qualifyingOrderId)) &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.qualifyingOrderId)).data.customerId == resource.data.referredUserId &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.qualifyingOrderId)).data.orderStatus in ['completed', 'delivered'] &&
        request.resource.data.referrerUserId == resource.data.referrerUserId &&
        request.resource.data.referredUserId == resource.data.referredUserId &&
        request.resource.data.rewardPoints == resource.data.rewardPoints &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'qualifyingOrderId', 'rewardedAt', 'updatedAt'])
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // NOTIFICATIONS COLLECTION (/notifications/{notificationId}) — NOTIFICATION SECURITY
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (('recipientEmail' in resource.data) && (
            resource.data.recipientEmail == request.auth.token.email ||
            resource.data.recipientEmail == request.auth.token.email.lower()
          ))
        )
      );

      // Restrict notification creation to legitimate system and transaction events
      allow create: if isAdmin() || (
        isAuthenticated() && (
          // 1. Self notification
          request.resource.data.userId == request.auth.uid ||
          // 2. Seller storefront application notification dispatched to Admin
          (
            request.resource.data.userId == 'admin' &&
            request.resource.data.type == 'system' &&
            notificationId.matches('notif_seller_app_.*')
          ) ||
          // 3. Seller dispatch notice to customer
          (
            isShopkeeper() &&
            request.resource.data.type == 'order'
          ) ||
          // 4. Point transfer notification to counterparty
          (
            request.resource.data.type == 'transfer' &&
            request.resource.data.userId is string &&
            request.resource.data.userId != request.auth.uid
          ) ||
          // 5. Referral bonus reward notice to referrer
          (
            request.resource.data.type == 'points' &&
            request.resource.data.userId is string
          )
        )
      );

      allow update: if isAdmin() || (
        isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );

      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // =========================================================================
    // ADMIN SETTINGS, AUDIT LOGS, AND CART
    // =========================================================================
    match /adminSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    match /cart/{cartId} {
      allow read, write: if isOwner(cartId) || isAdmin();
    }

    // =========================================================================
    // DEFAULT DENY FOR ALL OTHER PATHS
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
